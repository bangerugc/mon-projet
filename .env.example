# ─────────────────────────────────────────────────────────────────────────
# Modèle d'environnement — COMMITÉ, valeurs VIDES (§12).
# Pour l'utiliser : `cp .env.example .env.local` puis remplis .env.local.
# .env.local n'est JAMAIS commité (voir .gitignore). Aucun secret ici.
# ─────────────────────────────────────────────────────────────────────────

# Transcription OpenAI — clé server-only (jamais côté client, jamais NEXT_PUBLIC_)
# ⚠️ Mets un usage limit (~20 $/mois) sur la clé côté platform.openai.com.
OPENAI_API_KEY=

# AWS — credentials Remotion Lambda (server-only)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Remotion Lambda — renseignés après `remotion lambda functions deploy` / `sites create`
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=

# S3 — bucket d'upload des vidéos sources
S3_UPLOAD_BUCKET=
